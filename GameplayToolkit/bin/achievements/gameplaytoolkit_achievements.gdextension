; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/2.🧭Widgets & Spatialité🌍/🏆Succès - Réalisation/achievements_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "achievements_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

AchievementCondition = "res://🖼️Editor Icons/🧭🌍/AchievementCondition Icon.png"
AchievementCounterCondition = "res://🖼️Editor Icons/🧭🌍/AchievementCounterCondition Icon.png"
AchievementCollectionCondition = "res://🖼️Editor Icons/🧭🌍/AchievementCollectionCondition Icon.png"
Achievement = "res://🖼️Editor Icons/🧭🌍/Achievement Icon.png"
AchievementManager = "res://🖼️Editor Icons/🧭🌍/AchievementManager Icon.png"

