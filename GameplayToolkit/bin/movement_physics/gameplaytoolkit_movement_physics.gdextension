; Généré par le Sconstruct depuis src/2.⚔️Ensemble Systèmes de Gameplay/5.🌀Mouvement & Physique🫗/movement_physics_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "movement_physics_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

MovementComponent = "res://🖼️Editor Icons/🌀🫗/CharacterMovement.png"
