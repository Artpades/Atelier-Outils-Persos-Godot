; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/2.🧭Widgets & Spatialité🌍/🖥️HUD interactive dans Monde 3D/spatial_hud_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "spatial_hud_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

InteractiveHUD3D = "res://🖼️Editor Icons/🧭🌍/HUD Icon.png"

[libraries]

macos.debug = "res://bin/spatial_hud/libgameplaytoolkit_spatial_hud.macos.template_debug.dylib"
macos.release = "res://bin/spatial_hud/libgameplaytoolkit_spatial_hud.macos.template_release.dylib"
