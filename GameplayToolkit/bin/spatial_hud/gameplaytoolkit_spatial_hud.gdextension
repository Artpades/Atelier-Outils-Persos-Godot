windows.release.x86_64 = "res://bin/spatial_hud/gameplaytoolkit_spatial_hud.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/spatial_hud/libgameplaytoolkit_spatial_hud.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/spatial_hud/libgameplaytoolkit_spatial_hud.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/spatial_hud/libgameplaytoolkit_spatial_hud.linux.template_debug.arm64.so"
