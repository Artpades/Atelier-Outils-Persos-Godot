; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/2.🧭Widgets & Spatialité🌍/🎞️Gestion de Caméras🎛️/camera_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "camera_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

CameraManager = "res://🖼️Editor Icons/🎥🎞️/CameraManager Icon.png"
CameraPanner = "res://🖼️Editor Icons/🎥🎞️/VirtualCamera Icon.png"
OrbitalCamera = "res://🖼️Editor Icons/🎥🎞️/OrbitalCamera Icon.png"

