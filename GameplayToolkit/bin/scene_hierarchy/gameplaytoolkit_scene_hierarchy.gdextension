; 🌳 Hiérarchie de scène
; Généré par le Sconstruct depuis module.json : ne pas modifier à la main.
; Optionnel : journal — messages dans le Journal (sinon console)

[configuration]

entry_symbol = "gameplaytoolkit_scene_hierarchy_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]


[libraries]

macos.debug = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.macos.template_debug.dylib"
macos.release = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/scene_hierarchy/gameplaytoolkit_scene_hierarchy.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/scene_hierarchy/gameplaytoolkit_scene_hierarchy.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/scene_hierarchy/gameplaytoolkit_scene_hierarchy.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/scene_hierarchy/gameplaytoolkit_scene_hierarchy.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.android.debug.arm64.so"
android.release.arm64 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.android.release.arm64.so"
android.debug.arm32 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.android.debug.arm32.so"
android.release.arm32 = "res://bin/scene_hierarchy/libgameplaytoolkit_scene_hierarchy.android.release.arm32.so"
