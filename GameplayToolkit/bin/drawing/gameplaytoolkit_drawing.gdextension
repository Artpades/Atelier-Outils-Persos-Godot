; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/2.🧭Widgets & Spatialité🌍/✏️Système de dessin/drawing_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "drawing_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

