; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/2.🧭Widgets & Spatialité🌍/✊📦🤚Glisser-Déposer d'objet/drag_and_drop_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "drag_and_drop_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

DraggableComponent = "res://🖼️Editor Icons/🧭🌍/Grabbale Icon.png"
DragAndDropSystem = "res://🖼️Editor Icons/🧭🌍/Point And Click Icon.png"

