; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/3.✨Effets Spéciaux et Sensations🎵/fx_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "fx_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

Effect = "res://🖼️Editor Icons/✨🎵/Fancy UI Icon.png"
PlayerFX = "res://🖼️Editor Icons/✨🎵/Fancy UI Icon.png"
FXStretchAndSquash = "res://🖼️Editor Icons/✨🎵/Squash And Stretch Icon.png"
FXChangeSize = "res://🖼️Editor Icons/✨🎵/Tween Player icon.png"
FXShake = "res://🖼️Editor Icons/✨🎵/Shake FX Icon.png"
FXTargeter = "res://🖼️Editor Icons/✨🎵/Targeter Icon.png"
FXFollower = "res://🖼️Editor Icons/✨🎵/Follower FX Icon.png"
FXAudio = "res://🖼️Editor Icons/✨🎵/Fx Audio icon.png"
TimeManipulatorFX = "res://🖼️Editor Icons/✨🎵/TimeManipulator FX Icon.png"
MusicLooper = "res://🖼️Editor Icons/✨🎵/MusicManager.png"

[libraries]

macos.debug = "res://bin/fx/libgameplaytoolkit_fx.macos.template_debug.dylib"
macos.release = "res://bin/fx/libgameplaytoolkit_fx.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/fx/gameplaytoolkit_fx.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/fx/gameplaytoolkit_fx.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/fx/gameplaytoolkit_fx.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/fx/gameplaytoolkit_fx.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/fx/libgameplaytoolkit_fx.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/fx/libgameplaytoolkit_fx.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/fx/libgameplaytoolkit_fx.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/fx/libgameplaytoolkit_fx.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/fx/libgameplaytoolkit_fx.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/fx/libgameplaytoolkit_fx.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/fx/libgameplaytoolkit_fx.android.debug.arm64.so"
android.release.arm64 = "res://bin/fx/libgameplaytoolkit_fx.android.release.arm64.so"
android.debug.arm32 = "res://bin/fx/libgameplaytoolkit_fx.android.debug.arm32.so"
android.release.arm32 = "res://bin/fx/libgameplaytoolkit_fx.android.release.arm32.so"
