; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/1.📁Intercepteurs de données🔌/🗄️Multijoueur/multiplayer_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "multiplayer_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

SecureChannel = "res://🖼️Editor Icons/💾🔐/EncryptionKey Icon.png"
LanDiscovery = "res://🖼️Editor Icons/🎮🔌/LanDiscovery Icon.png"
NetworkSession = "res://🖼️Editor Icons/🎮🔌/NetworkSession Icon.png"

[libraries]

macos.debug = "res://bin/multiplayer/libgameplaytoolkit_multiplayer.macos.template_debug.dylib"
