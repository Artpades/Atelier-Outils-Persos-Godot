; 🧑‍💻 Édition et Debug
; Généré par le Sconstruct depuis module.json : ne pas modifier à la main.

[configuration]

entry_symbol = "gameplaytoolkit_edition_debug_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

Gizmos2D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
Gizmos3D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
ManagerBuilder = "res://🖼️Editor Icons/🧰🧑‍💻/ManagerBase icon.png"
WidgetPropertyModifierBuilder = "res://🖼️Editor Icons/🧰🧑‍💻/Settings Panel Icon.png"
ProceduralInspector = "res://🖼️Editor Icons/🧰🧑‍💻/Settings Panel Icon.png"
WindowEditor = "res://🖼️Editor Icons/🧰🧑‍💻/WindowEditor icon.png"

[libraries]

macos.debug = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.macos.template_debug.dylib"
macos.release = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/edition_debug/gameplaytoolkit_edition_debug.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/edition_debug/gameplaytoolkit_edition_debug.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/edition_debug/gameplaytoolkit_edition_debug.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/edition_debug/gameplaytoolkit_edition_debug.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.android.debug.arm64.so"
android.release.arm64 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.android.release.arm64.so"
android.debug.arm32 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.android.debug.arm32.so"
android.release.arm32 = "res://bin/edition_debug/libgameplaytoolkit_edition_debug.android.release.arm32.so"
