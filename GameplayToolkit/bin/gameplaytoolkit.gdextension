[configuration]

entry_symbol = "library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]
ManagerBuilder = "res://🖼️Editor Icons/🧰🧑‍💻/ManagerBase icon.png"
WindowEditor = "res://🖼️Editor Icons/🧰🧑‍💻/WindowEditor icon.png"
Gizmos2D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
Gizmos3D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
WidgetPropertyModifierBuilder = "res://🖼️Editor Icons/🧰🧑‍💻/Settings Panel Icon.png"
[libraries]

macos.debug = "res://bin/libgameplaytoolkit.macos.template_debug.dylib"
macos.release = "res://bin/libgameplaytoolkit.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/libgameplaytoolkit.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/libgameplaytoolkit.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/libgameplaytoolkit.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libgameplaytoolkit.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libgameplaytoolkit.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgameplaytoolkit.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libgameplaytoolkit.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libgameplaytoolkit.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/libgameplaytoolkit.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/libgameplaytoolkit.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/libgameplaytoolkit.android.debug.arm64.so"
android.release.arm64 = "res://bin/libgameplaytoolkit.android.release.arm64.so"
android.debug.arm32 = "res://bin/libgameplaytoolkit.android.debug.arm32.so"
android.release.arm32 = "res://bin/libgameplaytoolkit.android.release.arm32.so"
