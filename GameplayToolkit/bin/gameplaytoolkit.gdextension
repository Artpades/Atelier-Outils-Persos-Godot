[configuration]

entry_symbol = "library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]
ManagerBuilder = "res://🖼️Editor Icons/🧰🧑‍💻/ManagerBase icon.png"
WindowEditor = "res://🖼️Editor Icons/🧰🧑‍💻/WindowEditor icon.png"
Gizmos2D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
Gizmos3D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
WidgetPropertyModifierBuilder = "res://🖼️Editor Icons/🧰🧑‍💻/Settings Panel Icon.png"
ProceduralInspector = "res://🖼️Editor Icons/🧰🧑‍💻/Settings Panel Icon.png"
Gauge = "res://🖼️Editor Icons/💾🔐/Gauge Icon.png"
SaveConfig = "res://🖼️Editor Icons/💾🔐/SaveConfig Icon.png"
SaveData = "res://🖼️Editor Icons/💾🔐/FloppyDisk Icon.png"
SaveDataBinder = "res://🖼️Editor Icons/💾🔐/SaveManager Icon.png"
SaveManager = "res://🖼️Editor Icons/💾🔐/SaveManager Icon.png"
InputAction = "res://🖼️Editor Icons/🎮🔌/InputAction Icon.png"
InputButtonAction = "res://🖼️Editor Icons/🎮🔌/InputButtonAction Icon.png"
InputAxisAction = "res://🖼️Editor Icons/🎮🔌/InputAxisAction Icon.png"
InputCircleAction = "res://🖼️Editor Icons/🎮🔌/InputVector2Action Icon.png"
InputSphereAction = "res://🖼️Editor Icons/🎮🔌/InputVector3Action Icon-export.png"
InputJoyGyroAction = "res://🖼️Editor Icons/🎮🔌/JoyPadMotion Icon.png"
InputMouseAction = "res://🖼️Editor Icons/🎮🔌/InputMouseAction Icon.png"
InputTouchAction = "res://🖼️Editor Icons/🎮🔌/InputScreenSphere Icon.png"
InputContext = "res://🖼️Editor Icons/🎮🔌/InputContexte Icon.png"
PlayerInput = "res://🖼️Editor Icons/🎮🔌/InputManager Icon.png"
InputRebinder = "res://🖼️Editor Icons/🎮🔌/InputMapBinding Icon.png"
PlayerInputUI = "res://🖼️Editor Icons/🎮🔌/ButtonAssigned Icon.png"
CameraManager = "res://🖼️Editor Icons/🎥🎞️/CameraManager Icon.png"
[libraries]

macos.debug = "res://bin/libgameplaytoolkit.macos.template_debug.dylib"
macos.release = "res://bin/libgameplaytoolkit.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/gameplaytoolkit.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/gameplaytoolkit.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/gameplaytoolkit.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/gameplaytoolkit.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libgameplaytoolkit.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgameplaytoolkit.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libgameplaytoolkit.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libgameplaytoolkit.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/libgameplaytoolkit.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/libgameplaytoolkit.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/libgameplaytoolkit.android.debug.arm64.so"
android.release.arm64 = "res://bin/libgameplaytoolkit.android.release.arm64.so"
android.debug.arm32 = "res://bin/libgameplaytoolkit.android.debug.arm32.so"
android.release.arm32 = "res://bin/libgameplaytoolkit.android.release.arm32.so"
