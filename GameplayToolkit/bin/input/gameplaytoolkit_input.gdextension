; 🎮 Périphériques d'entrée
; Généré par le Sconstruct depuis module.json : ne pas modifier à la main.
; Requiert : widgets — PlayerInputUI (liaisons InspectorBinding)
; Requiert : save — PlayerInputUI (sauvegarde des affectations)
; Optionnel : gizmos — dessin de debug des InputAction
; Optionnel : journal — messages dans le Journal (sinon console)

[configuration]

entry_symbol = "gameplaytoolkit_input_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

InputAction = "res://🖼️Editor Icons/🎮🔌/InputAction Icon.png"
InputButtonAction = "res://🖼️Editor Icons/🎮🔌/InputButtonAction Icon.png"
InputAxisAction = "res://🖼️Editor Icons/🎮🔌/InputAxisAction Icon.png"
InputCircleAction = "res://🖼️Editor Icons/🎮🔌/InputVector2Action Icon.png"
InputSphereAction = "res://🖼️Editor Icons/🎮🔌/InputVector3Action Icon-export.png"
InputJoyGyroAction = "res://🖼️Editor Icons/🎮🔌/JoyPadMotion Icon.png"
InputMouseAction = "res://🖼️Editor Icons/🎮🔌/InputMouseAction Icon.png"
InputTouchAction = "res://🖼️Editor Icons/🎮🔌/InputScreenSphere Icon.png"
InputContext = "res://🖼️Editor Icons/🎮🔌/InputContexte Icon.png"
PlayerInput = "res://🖼️Editor Icons/🎮🔌/InputManager Icon.png"
InputRebinder = "res://🖼️Editor Icons/🎮🔌/InputMapBinding Icon.png"
PlayerInputUI = "res://🖼️Editor Icons/🎮🔌/ButtonAssigned Icon.png"

[libraries]

macos.debug = "res://bin/input/libgameplaytoolkit_input.macos.template_debug.dylib"
macos.release = "res://bin/input/libgameplaytoolkit_input.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/input/gameplaytoolkit_input.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/input/gameplaytoolkit_input.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/input/gameplaytoolkit_input.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/input/gameplaytoolkit_input.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/input/libgameplaytoolkit_input.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/input/libgameplaytoolkit_input.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/input/libgameplaytoolkit_input.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/input/libgameplaytoolkit_input.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/input/libgameplaytoolkit_input.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/input/libgameplaytoolkit_input.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/input/libgameplaytoolkit_input.android.debug.arm64.so"
android.release.arm64 = "res://bin/input/libgameplaytoolkit_input.android.release.arm64.so"
android.debug.arm32 = "res://bin/input/libgameplaytoolkit_input.android.debug.arm32.so"
android.release.arm32 = "res://bin/input/libgameplaytoolkit_input.android.release.arm32.so"
