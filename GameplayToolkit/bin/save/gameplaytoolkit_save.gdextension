; 💾 Manipulateur de données
; Généré par le Sconstruct depuis module.json : ne pas modifier à la main.
; Optionnel : journal — messages dans le Journal (sinon console)

[configuration]

entry_symbol = "gameplaytoolkit_save_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

SaveConfig = "res://🖼️Editor Icons/💾🔐/SaveConfig Icon.png"
SaveData = "res://🖼️Editor Icons/💾🔐/FloppyDisk Icon.png"
SaveDataBinder = "res://🖼️Editor Icons/💾🔐/SaveManager Icon.png"
SaveManager = "res://🖼️Editor Icons/💾🔐/SaveManager Icon.png"

[libraries]

macos.debug = "res://bin/save/libgameplaytoolkit_save.macos.template_debug.dylib"
macos.release = "res://bin/save/libgameplaytoolkit_save.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/save/gameplaytoolkit_save.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/save/gameplaytoolkit_save.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/save/gameplaytoolkit_save.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/save/gameplaytoolkit_save.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/save/libgameplaytoolkit_save.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/save/libgameplaytoolkit_save.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/save/libgameplaytoolkit_save.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/save/libgameplaytoolkit_save.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/save/libgameplaytoolkit_save.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/save/libgameplaytoolkit_save.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/save/libgameplaytoolkit_save.android.debug.arm64.so"
android.release.arm64 = "res://bin/save/libgameplaytoolkit_save.android.release.arm64.so"
android.debug.arm32 = "res://bin/save/libgameplaytoolkit_save.android.debug.arm32.so"
android.release.arm32 = "res://bin/save/libgameplaytoolkit_save.android.release.arm32.so"
