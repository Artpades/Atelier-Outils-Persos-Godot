[node name="Panneau" type="PanelContainer" parent="Interface"]
script = ExtResource("2_panneau")
titre = "🎭 Changeur de visuels"
aide = "Chaque tenue (VisualsAsset) liste des VisualsRegister : chemin d'un nœud + ressource. Selon le type du nœud, la texture, le mesh ou une scène (dans un conteneur) est appliqué. La tenue « ombre » ne change que le corps : le reste est conservé."
