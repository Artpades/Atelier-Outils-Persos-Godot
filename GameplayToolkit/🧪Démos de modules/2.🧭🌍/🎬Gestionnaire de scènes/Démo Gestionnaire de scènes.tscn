[gd_scene format=3]

[ext_resource type="Script" path="res://🧪Démos de modules/2.🧭🌍/🎬Gestionnaire de scènes/demo_gestionnaire_scenes.gd" id="1_demo"]
[ext_resource type="Script" path="res://🧪Démos de modules/2.🧭🌍/panneau_demo.gd" id="2_panneau"]

[node name="DémoGestionnaireDeScènes" type="Node"]
script = ExtResource("1_demo")

[node name="Fond" type="CanvasLayer" parent="."]
layer = -1

[node name="Couleur" type="ColorRect" parent="Fond"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.11, 0.12, 0.15, 1)

[node name="Zone" type="VBoxContainer" parent="Fond"]
anchors_preset = 4
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = 40.0
offset_top = -60.0
offset_right = 640.0
offset_bottom = 60.0
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Titre" type="Label" parent="Fond/Zone"]
theme_override_font_sizes/font_size = 28
text = "🎬 Scène de départ"

[node name="Etat" type="Label" parent="Fond/Zone"]
unique_name_in_owner = true
text = "Aucun chargement en cours"

[node name="Barre" type="ProgressBar" parent="Fond/Zone"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)

[node name="Interface" type="CanvasLayer" parent="."]

[node name="Panneau" type="PanelContainer" parent="Interface"]
script = ExtResource("2_panneau")
titre = "🎬 Gestionnaire de scènes"
aide = "Le chargement se fait en arrière-plan : loading_started, puis loading_progress jusqu'à 100, puis la scène change et load_finished est émis (reçu par la scène de destination). Une petite scène se charge presque instantanément."
