[gd_scene format=3]

[ext_resource type="Script" path="res://🧪Démos de modules/1.📁🔌/🗄️Multijoueur/demo_client_distant.gd" id="1_client"]

[node name="DémoClientDistant" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_client")

[node name="Session" type="NetworkSession" parent="."]
unique_name_in_owner = true
connection_timeout = 10.0

[node name="Fond" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.11, 0.12, 0.15, 1)

[node name="Marges" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Colonnes" type="HBoxContainer" parent="Marges"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="DefilementGauche" type="ScrollContainer" parent="Marges/Colonnes"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Gauche" type="VBoxContainer" parent="Marges/Colonnes/DefilementGauche"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="Titre" type="Label" parent="Marges/Colonnes/DefilementGauche/Gauche"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "💻 Rejoindre un serveur distant"

[node name="LabelCode" type="Label" parent="Marges/Colonnes/DefilementGauche/Gauche"]
layout_mode = 2
text = "Code de connexion (donné par le serveur)"

[node name="LigneCode" type="HBoxContainer" parent="Marges/Colonnes/DefilementGauche/Gauche"]
layout_mode = 2

[node name="Code" type="LineEdit" parent="Marges/Colonnes/DefilementGauche/Gauche/LigneCode"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "gtk://…"

[node name="BoutonColler" type="Button" parent="Marges/Colonnes/DefilementGauche/Gauche/LigneCode"]
unique_name_in_owner = true
layout_mode = 2
text = "📋 Coller"

[node name="AideCode" type="Label" parent="Marges/Colonnes/DefilementGauche/Gauche"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.64, 0.7, 1)
theme_override_font_sizes/font_size = 12
text = "Le code contient l'adresse, le port et l'empreinte du serveur : ce client vérifie qu'il parle bien au bon serveur. Sans code, saisir l'adresse ci-dessous (serveur non vérifié)."
autowrap_mode = 3

[node name="GrilleAdresse" type="GridContainer" parent="Marges/Colonnes/DefilementGauche/Gauche"]
layout_mode = 2
theme_override_constants/h_separation = 8
columns = 2

[node name="LabelAdresse" type="Label" parent="Marges/Colonnes/DefilementGauche/Gauche/GrilleAdresse"]
layout_mode = 2
text = "Adresse"

[node name="Adresse" type="LineEdit" parent="Marges/Colonnes/DefilementGauche/Gauche/GrilleAdresse"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
