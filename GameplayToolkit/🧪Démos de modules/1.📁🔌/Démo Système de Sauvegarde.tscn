[gd_scene format=3]

[ext_resource type="Script" path="res://🧪Démos de modules/1.📁🔌/demo_systeme_sauvegarde.gd" id="1_demo"]
[ext_resource type="Script" path="res://🧪Démos de modules/1.📁🔌/joueur_demo_sauvegarde.gd" id="2_joueur"]
[ext_resource type="Script" path="res://🧪Démos de modules/1.📁🔌/parametres_demo_sauvegarde.gd" id="3_parametres"]

[sub_resource type="SaveConfig" id="SaveConfig_demo"]
save_directory = "user://demo_saves/"

[sub_resource type="SaveData" id="SaveData_joueur"]
system_id = "joueur_demo"
is_encrypted = false
encryption_key = "DemoGameplayToolkitCle32Octets!!"
file_config = SubResource("SaveConfig_demo")

[sub_resource type="SaveData" id="SaveData_parametres"]
system_id = "parametres_demo"
encryption_key = "DemoGameplayToolkitCle32Octets!!"
file_config = SubResource("SaveConfig_demo")

[sub_resource type="Resource" id="Resource_parametres"]
script = ExtResource("3_parametres")

[node name="DémoSystèmeDeSauvegarde" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_demo")

[node name="Fond" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.11, 0.12, 0.15, 1)

[node name="Marges" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Colonnes" type="HBoxContainer" parent="Marges"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ZoneJeu" type="Panel" parent="Marges/Colonnes"]
clip_contents = true
layout_mode = 2
size_flags_horizontal = 3

[node name="Joueur" type="ColorRect" parent="Marges/Colonnes/ZoneJeu"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 120.0
offset_top = 200.0
offset_right = 168.0
offset_bottom = 248.0
color = Color(0.35, 0.75, 1, 1)
script = ExtResource("2_joueur")

[node name="Infos" type="Label" parent="Marges/Colonnes/ZoneJeu"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 12.0
offset_top = 8.0
offset_right = 320.0
offset_bottom = 160.0
text = "Infos"

[node name="Aide" type="Label" parent="Marges/Colonnes/ZoneJeu"]
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -34.0
offset_right = 420.0
offset_bottom = -8.0
grow_vertical = 0
modulate = Color(1, 1, 1, 0.6)
text = "Flèches / ZQSD : déplacer le joueur"

[node name="Commandes" type="VBoxContainer" parent="Marges/Colonnes"]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="Titre" type="Label" parent="Marges/Colonnes/Commandes"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "💾 Démo du système de sauvegarde"

[node name="TitreJoueur" type="Label" parent="Marges/Colonnes/Commandes"]
layout_mode = 2
modulate = Color(1, 1, 1, 0.6)
text = "Joueur — SaveDataBinder → Node"

[node name="LignePseudo" type="HBoxContainer" parent="Marges/Colonnes/Commandes"]
layout_mode = 2

[node name="Label" type="Label" parent="Marges/Colonnes/Commandes/LignePseudo"]
layout_mode = 2
text = "Pseudo"

[node name="ChampPseudo" type="LineEdit" parent="Marges/Colonnes/Commandes/LignePseudo"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="LigneJoueur" type="HBoxContainer" parent="Marges/Colonnes/Commandes"]
layout_mode = 2

[node name="BoutonPiece" type="Button" parent="Marges/Colonnes/Commandes/LigneJoueur"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "+1 pièce"

[node name="BoutonNiveau" type="Button" parent="Marges/Colonnes/Commandes/LigneJoueur"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "+1 niveau"

[node name="BoutonDegats" type="Button" parent="Marges/Colonnes/Commandes/LigneJoueur"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "-10 PV"

[node name="CaseChiffrement" type="CheckBox" parent="Marges/Colonnes/Commandes"]
unique_name_in_owner = true
layout_mode = 2
text = "Chiffrer la sauvegarde du joueur (.sav)"

[node name="TitreParametres" type="Label" parent="Marges/Colonnes/Commandes"]
layout_mode = 2
modulate = Color(1, 1, 1, 0.6)
text = "Paramètres — SaveDataBinder → Resource (chiffré)"

[node name="LigneParametres" type="HBoxContainer" parent="Marges/Colonnes/Commandes"]
layout_mode = 2

[node name="Label" type="Label" parent="Marges/Colonnes/Commandes/LigneParametres"]
layout_mode = 2
text = "Volume"

[node name="SliderVolume" type="HSlider" parent="Marges/Colonnes/Commandes/LigneParametres"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="CasePleinEcran" type="CheckBox" parent="Marges/Colonnes/Commandes/LigneParametres"]
unique_name_in_owner = true
layout_mode = 2
text = "Plein écran"

[node name="Separateur" type="HSeparator" parent="Marges/Colonnes/Commandes"]
layout_mode = 2

[node name="LigneFichier" type="HBoxContainer" parent="Marges/Colonnes/Commandes"]
layout_mode = 2

[node name="BoutonSauvegarder" type="Button" parent="Marges/Colonnes/Commandes/LigneFichier"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "💾 Sauvegarder"

[node name="BoutonCharger" type="Button" parent="Marges/Colonnes/Commandes/LigneFichier"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "📖 Charger"

[node name="BoutonSupprimer" type="Button" parent="Marges/Colonnes/Commandes/LigneFichier"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "🗑️ Supprimer"

[node name="LigneOutils" type="HBoxContainer" parent="Marges/Colonnes/Commandes"]
layout_mode = 2

[node name="BoutonFichiers" type="Button" parent="Marges/Colonnes/Commandes/LigneOutils"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "📄 Voir les fichiers"

[node name="BoutonTests" type="Button" parent="Marges/Colonnes/Commandes/LigneOutils"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "🧪 Relancer les tests"

[node name="Journal" type="RichTextLabel" parent="Marges/Colonnes/Commandes"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true
selection_enabled = true

[node name="BinderJoueur" type="SaveDataBinder" parent="."]
save_data = SubResource("SaveData_joueur")
node_target = NodePath("../Marges/Colonnes/ZoneJeu/Joueur")
tracked_properties = PackedStringArray("pseudo", "pieces", "niveau", "pv", "pos_x", "pos_y")

[node name="BinderParametres" type="SaveDataBinder" parent="."]
save_data = SubResource("SaveData_parametres")
resource_target = SubResource("Resource_parametres")
tracked_properties = PackedStringArray("volume", "langue", "plein_ecran")
