[sub_resource type="CursorStyle" id="Style_fleche"]
frames = Array[Texture2D]([ExtResource("3_fleche")])
hotspot = Vector2(2, 2)

[sub_resource type="CursorStyle" id="Style_fleche_clic"]
frames = Array[Texture2D]([ExtResource("4_fleche_clic")])
hotspot = Vector2(2, 2)

[sub_resource type="CursorStyle" id="Style_main"]
frames = Array[Texture2D]([ExtResource("5_main")])
hotspot = Vector2(13, 2)

[sub_resource type="CursorStyle" id="Style_chargement"]
frames = Array[Texture2D]([ExtResource("6_charge1"), ExtResource("7_charge2"), ExtResource("8_charge3"), ExtResource("9_charge4")])
frames_per_second = 8.0
hotspot = Vector2(16, 16)

[sub_resource type="StyleBoxFlat" id="Style_infobulle"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.1, 0.1, 0.16, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.75, 0.3, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[sub_resource type="TooltipContent" id="Infobulle_survol"]
title = "Bouton survolé"
text = "Au survol : [b]agrandissement[/b] (FXChangeSize) et [color=cyan]curseur main[/color] (CursorChanger en mode survol)."

[sub_resource type="TooltipContent" id="Infobulle_clic"]
title = "Bouton cliqué"
text = "Au clic : [b]secousse[/b] (FXShake) avec un son enchaîné. Au survol : curseur [i]animé[/i] (4 images)."

[sub_resource type="TooltipContent" id="Infobulle_video"]
title = "🎬 Infobulle vidéo"
text = "Une infobulle peut contenir une [b]vidéo[/b] (VideoStream, ici un .ogv) jouée en boucle pendant l'affichage."
video = ExtResource("10_video")

[sub_resource type="TooltipContent" id="Icone_epee"]
title = "Épée"
text = "Dégâts : [color=orange]12[/color]
Une lame simple mais fiable."
icon = ExtResource("12_orange")

[sub_resource type="TooltipContent" id="Icone_potion"]
title = "Potion"
text = "Rend [color=green]30 PV[/color]."
icon = ExtResource("13_vert")

[sub_resource type="TooltipContent" id="Icone_bouclier"]
title = "Bouclier"
text = "Le contenu d'une infobulle peut aussi être une [b]scène personnalisée[/b] :"
custom_scene = ExtResource("11_jauge")

[sub_resource type="TooltipContent" id="Icone_parchemin"]
title = "Parchemin"
text = "Un texte long revient à la ligne à [code]max_width[/code] : Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
max_width = 260.0

[sub_resource type="TooltipContent" id="Icone_gemme"]
title = "Gemme"
icon = ExtResource("15_violet")
icon_max_size = Vector2(96, 96)

[sub_resource type="TooltipContent" id="Icone_carte"]
title = "Carte"
text = "Infobulle sans délai ([code]delay = 0[/code]) qui ne suit pas la souris."

[sub_resource type="TooltipContent" id="Icone_cle"]
title = "Clé"
text = "Clavier / manette : [b]Tab[/b] donne le focus aux icônes, le dock grossit autour."

[sub_resource type="FXChangeSize" id="FX_survol"]
final_scale = 1.15
duration = 0.15

[sub_resource type="FXAudio" id="FX_son"]
stream = ExtResource("18_blip")
randomize_pitch_scale = true

[sub_resource type="FXShake" id="FX_clic"]
effects_on_play_fx = Array[Effect]([SubResource("FX_son")])
duration = 0.35
frequency = 30.0
max_amplitude = 8.0

[sub_resource type="Gradient" id="Degrade_volet"]

[sub_resource type="GradientTexture2D" id="Masque_volet"]
gradient = SubResource("Degrade_volet")
width = 256
height = 16

[sub_resource type="Gradient" id="Degrade_cercle"]
colors = PackedColorArray(1, 1, 1, 1, 0, 0, 0, 1)

[sub_resource type="GradientTexture2D" id="Masque_cercle"]
gradient = SubResource("Degrade_cercle")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.2, 0.5)

[sub_resource type="FastNoiseLite" id="Bruit_dissolution"]
frequency = 0.03

[sub_resource type="NoiseTexture2D" id="Masque_dissolution"]
width = 256
height = 256
noise = SubResource("Bruit_dissolution")

