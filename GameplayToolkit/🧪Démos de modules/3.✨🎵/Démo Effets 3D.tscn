script = ExtResource("2_panneau")
titre = "✨ Effets 3D"
aide = "Les mêmes effets sur des nœuds 3D. La couleur de la sphère est animée par FXFade via le chemin « material_override:albedo_color ». La caméra de ciblage (FXTargeter) vise les lunes et le cube, et recule pour les garder tous dans le champ."
