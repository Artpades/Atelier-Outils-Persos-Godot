[node name="Interface" type="CanvasLayer" parent="."]

[node name="Panneau" type="PanelContainer" parent="Interface"]
script = ExtResource("2_panneau")
titre = "🔁 Music Looper"
aide = "Le morceau joue son intro, répète la section [loop_start, loop_end] (loop_count fois, -1 : sans fin), puis sa fin. En WAV, ou en OGG bouclé jusqu'à la fin du fichier, la boucle est exacte à l'échantillon ; sinon le retour est fait à chaque frame."
