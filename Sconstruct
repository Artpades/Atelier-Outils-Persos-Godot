import os
import re
import subprocess
import sys

# =====================================================================================================
#  ORGANISATION : une GDExtension par fichier de registre, détectée automatiquement
# =====================================================================================================
#
#  Le script parcourt src/ à la recherche des fichiers de registre :
#
#    - register.cpp        -> bibliothèque PRINCIPALE  (une seule autorisée)
#                             GameplayToolkit/bin/gameplaytoolkit.gdextension
#    - <id>_register.cpp   -> MODULE <id>
#                             GameplayToolkit/bin/<id>/gameplaytoolkit_<id>.gdextension
#
#  Chaque bibliothèque contient tous les .cpp du dossier de son registre (sous-dossiers compris),
#  SAUF les sous-dossiers qui ont eux-mêmes un fichier de registre : ceux-là forment leur propre
#  bibliothèque. Le register.cpp placé à la racine de src/ récupère donc tout ce qui n'appartient
#  à aucun module.
#
#  Le fichier .gdextension de chaque bibliothèque est GÉNÉRÉ (ne pas le modifier à la main) à partir
#  de ce que le script lit dans le registre :
#    - entry_symbol  <- le nom de la fonction  extern "C" ... GDE_EXPORT <nom>(...)
#    - [icons]       <- les icônes déjà présentes dans le fichier (on peut les écrire à la main : elles sont
#                       conservées), complétées par les commentaires « // @icon <chemin> » placés sur la ligne
#                       d'un GDREGISTER_*CLASS (prioritaires si la même classe a déjà une icône)
#    - [libraries]   <- les chemins des bibliothèques compilées pour chaque plateforme
#  Les classes enregistrées (GDREGISTER_CLASS, GDREGISTER_ABSTRACT_CLASS, ...) servent aussi à choisir
#  la documentation XML embarquée dans chaque bibliothèque.
#
#  Pour utiliser un module dans un autre projet : copier le dossier bin/<id>/. Pour l'enlever : le supprimer.
#
#  Commandes :
#    scons                 -> compile la lib principale + tous les modules (et régénère les .gdextension)
#    scons journal         -> compile uniquement le module "journal" (idem avec n'importe quel id)
#    scons principal       -> compile uniquement la lib principale
#    scons gen_doc         -> génère / met à jour TOUS les XML de doc_classes/ via Godot --doctool
#
#  Documentation : en template_debug (cible par défaut), si une classe enregistrée n'a pas encore de
#  doc_classes/<Classe>.xml, Godot --doctool est lancé automatiquement APRÈS la compilation pour le créer.
#  Le XML est intégré à la bibliothèque au `scons` suivant (il doit exister avant la compilation).
#    scons auto_doc=no     -> désactive cette génération automatique
#    scons godot=<chemin>  -> exécutable Godot à utiliser (sinon variable d'environnement GODOT,
#                             sinon le chemin par défaut défini plus bas selon l'OS)
#
# -----------------------------------------------------------------------------------------------------
#  CRÉER UN NOUVEAU MODULE GDEXTENSION (pas à pas)
# -----------------------------------------------------------------------------------------------------
#
#  1. Code source : regrouper toutes les sources du module dans UN dossier de src/
#     (ex: "src/1.🧰Ensemble d'Outils/.../⏱️Chronomètre"). Tous les .cpp de ce dossier (et sous-dossiers)
#     seront compilés dans le module, et exclus de la lib principale.
#
#  2. Registre : ajouter dans ce dossier un fichier <id>_register.cpp. Son préfixe donne l'id du module
#     (chrono_register.cpp -> module "chrono", dossier bin/chrono/, commande `scons chrono`).
#     Modèle (exemple complet : "📰Journal Console/journal_register.cpp") :
#
#         #include <godot_cpp/core/class_db.hpp>
#         #include <godot_cpp/godot.hpp>
#         #include "ma_classe.hpp"
#         using namespace godot;
#
#         // "static" : fonctions privées à ce fichier, pour ne pas entrer en conflit
#         // avec les initialize()/uninitialize() des autres bibliothèques.
#         static void initialize_chrono(ModuleInitializationLevel p_level) {
#             if (p_level != MODULE_INITIALIZATION_LEVEL_SCENE) return; // sinon classes enregistrées 2 fois
#             GDREGISTER_CLASS(MaClasse); // @icon res://🖼️Editor Icons/mon_icone.png
#         }
#         static void uninitialize_chrono(ModuleInitializationLevel p_level) {}
#
#         extern "C" GDExtensionBool GDE_EXPORT chrono_library_init(   // <- NOM UNIQUE par module
#                 GDExtensionInterfaceGetProcAddress p_get_proc_address,
#                 GDExtensionClassLibraryPtr p_library, GDExtensionInitialization *r_initialization) {
#             GDExtensionBinding::InitObject init_obj(p_get_proc_address, p_library, r_initialization);
#             init_obj.register_initializer(initialize_chrono);
#             init_obj.register_terminator(uninitialize_chrono);
#             init_obj.set_minimum_library_initialization_level(MODULE_INITIALIZATION_LEVEL_SCENE);
#             return init_obj.init();
#         }
#
#  3. Lancer `scons` : le module est détecté, compilé, et son .gdextension écrit dans bin/<id>/.
#
#  4. Règles à respecter (les trois premières sont vérifiées par ce script) :
#        - Un seul fichier de registre par dossier, et des id de modules uniques.
#        - Le nom de la fonction GDE_EXPORT doit être unique d'une bibliothèque à l'autre.
#        - Une classe ne doit être enregistrée (GDREGISTER_*CLASS) que dans UNE seule bibliothèque,
#          sinon Godot signale une classe déjà existante.
#        - Un module ne doit pas #include le .hpp d'une classe d'un AUTRE module (le code ne serait pas
#          lié). Passer plutôt par Godot : ClassDB::instantiate("NomClasse"), obj->call("methode"), etc.
#        - Chaque bibliothèque embarque godot-cpp (~2,5 Mo) : c'est le coût normal de la séparation.
#
#  Limite de la lecture du registre : elle se fait ligne par ligne. Un GDREGISTER_*CLASS commenté avec
#  « // » est ignoré, mais pas un GDREGISTER_*CLASS placé dans un bloc /* ... */.
#
# -----------------------------------------------------------------------------------------------------
#  Modules prévus
# -----------------------------------------------------------------------------------------------------
#  Stock and flow · Système de sauvegarde · Entrées de périphérique · Entrées tactiles · Multijoueur
#  Système MIDI · XR · Gestion de caméra · Générateur d'objet · Gestion de scène
#  Changement de visuels à la demande · HUD spatial interactif · Système de dessin · Glisser/Déposer
#  Placement d'objets · Outils de terrain
#  Boîte d'ensemble d'interface graphique (Menu radial, interface de paramètre procédural)
#  Effets spéciaux programmés
#  Personnage et algo (Personnage, HFSM/BehaviourTree, Système de capacité, Système de dialogue)
#  Projectiles
#  Déplacement (au sol, aérodynamisme, aquatique, mural, recul, zone de force, animations procédurales)
#  Chronomètre · Métronome · Horloge
# =====================================================================================================

PROJECT_DIR = "GameplayToolkit"
BIN_DIR = PROJECT_DIR + "/bin"
LIBRARY_NAME = "gameplaytoolkit"
DOC_DIR = "doc_classes"

# Exécutable Godot 4.7 utilisé pour générer la doc (--doctool). Par ordre de priorité :
#   scons godot=<chemin>   >   variable d'environnement GODOT   >   chemin par défaut ci-dessous selon l'OS.
# (Retiré d'ARGUMENTS avant de charger godot-cpp, qui avertirait d'une variable inconnue.)
if sys.platform == "win32":
    DEFAULT_GODOT = r"D:\Tiroirs\Passions et Fascinations\4.🧑‍💻Programmation\Moteur de jeu\Godot_v4.7.2-stable_win64.exe\Godot_v4.7.2-stable_win64_console.exe"
else:
    DEFAULT_GODOT = "/home/artpade/.var/app/io.github.MakovWait.Godots/data/godot/app_userdata/Godots/versions/Godot_v4_7_2-stable_linux_x86_64/Godot_v4.7.2-stable_linux.x86_64"
GODOT_EXECUTABLE = ARGUMENTS.pop("godot", os.environ.get("GODOT", DEFAULT_GODOT))

# API GDExtension utilisée pour générer les bindings godot-cpp : extension_api.json et gdextension_interface.json
# à la racine du projet, produits par Godot 4.7.2 (godot-cpp n'embarque que l'API 4.6). Pour les régénérer :
#   <godot> --headless --dump-extension-api            -> extension_api.json
#   <godot> --headless --dump-gdextension-interface-json -> gdextension_interface.json
# Surcharge possible : scons gdextension_dir=<dossier> (ou custom_api_file=<fichier>).
# DÉSACTIVÉ : le générateur de cette version de godot-cpp (API ≤ 4.6) ne compile pas l'API 4.7
# (constantes globales UINT8_MAX, INT32_MIN... en conflit avec les macros de <cstdint>).
# ARGUMENTS.setdefault("gdextension_dir", Dir("#").abspath)

# Génération automatique des XML manquants après la compilation (désactivable : scons auto_doc=no).
AUTO_DOC = ARGUMENTS.pop("auto_doc", "yes").lower() not in ("no", "false", "0")

# register.cpp (groupe 1 vide -> lib principale) ou <id>_register.cpp (groupe 1 = id du module)
REGISTER_FILE = re.compile(r"^(?:(\w+)_)?register\.cpp$")
# extern "C" GDExtensionBool GDE_EXPORT <nom>(...)  -> entry_symbol du .gdextension
ENTRY_SYMBOL = re.compile(r"GDE_EXPORT\s+(\w+)\s*\(")
# GDREGISTER_CLASS(X), GDREGISTER_ABSTRACT_CLASS(X), GDREGISTER_VIRTUAL_CLASS(X), GDREGISTER_RUNTIME_CLASS(X)...
# Groupe 1 : le genre (« INTERNAL_ » pour GDREGISTER_INTERNAL_CLASS, classe invisible donc sans doc).
REGISTERED_CLASS = re.compile(r"GDREGISTER_(\w+_)?CLASS\s*\(\s*(\w+)\s*\)")
# // @icon res://chemin/vers/icone.png   (guillemets facultatifs, espaces autorisés dans le chemin)
ICON = re.compile(r"@icon\s+(.+?)\s*$")


def collect_sources(folder, excluded=()):
    """Tous les .cpp de folder (récursif), sans src/gen ni les dossiers exclus."""
    excluded = {os.path.normpath(e) for e in excluded}
    found = []
    for root, dirs, files in os.walk(folder):
        dirs.sort()
        # ne pas descendre dans src/gen (fichiers de doc générés, ajoutés explicitement plus bas)
        # ni dans les dossiers des autres bibliothèques (compilées séparément)
        dirs[:] = [d for d in dirs if d != "gen" and os.path.normpath(os.path.join(root, d)) not in excluded]
        found += [os.path.join(root, f) for f in sorted(files) if f.endswith(".cpp")]
    return found


def parse_register(path):
    """Lit un fichier de registre : (entry_symbol, {classe: icône ou ""}, [classes à documenter])."""
    with open(path, encoding="utf-8") as f:
        text = f.read()
    entry_symbols = ENTRY_SYMBOL.findall(text)
    if len(entry_symbols) != 1:
        raise Exception("{} : une seule fonction GDE_EXPORT attendue, trouvé {}".format(path, entry_symbols or "aucune"))
    classes = {}
    documented = []
    for line in text.splitlines():
        code, _, comment = line.partition("//")  # le code avant « // », le commentaire après
        match = REGISTERED_CLASS.search(code)
        if match:
            kind, class_name = match.groups()
            icon = ICON.search(comment)
            classes[class_name] = icon.group(1).strip('"') if icon else ""
            if kind != "INTERNAL_":
                documented.append(class_name)
    return entry_symbols[0], classes, documented


# --- 1. Découverte des bibliothèques (une par fichier de registre) ---
libraries_info = []
for root, dirs, files in os.walk("src"):
    dirs[:] = sorted(d for d in dirs if d != "gen")
    registers = [f for f in sorted(files) if REGISTER_FILE.match(f)]
    if not registers:
        continue
    if len(registers) > 1:
        raise Exception("Plusieurs fichiers de registre dans {} : {}".format(root, ", ".join(registers)))
    module_id = REGISTER_FILE.match(registers[0]).group(1)  # None pour register.cpp
    entry_symbol, classes, documented = parse_register(os.path.join(root, registers[0]))
    name = LIBRARY_NAME + ("_" + module_id if module_id else "")
    bin_dir = BIN_DIR + ("/" + module_id if module_id else "")
    libraries_info.append({
        "id": module_id,
        "alias": module_id or "principal",
        "dir": root,
        "register": os.path.join(root, registers[0]),
        "name": name,
        "bin_dir": bin_dir,
        "gdextension": "{}/{}.gdextension".format(bin_dir, name),
        "entry_symbol": entry_symbol,
        "classes": classes,
        "documented": documented,
    })

# Vérifications : ces erreurs feraient échouer le chargement dans Godot, autant les signaler ici.
seen = {"alias": {}, "entry_symbol": {}, "class": {}}
for info in libraries_info:
    for kind, values in (("alias", [info["alias"]]), ("entry_symbol", [info["entry_symbol"]]), ("class", info["classes"])):
        for value in values:
            if value in seen[kind]:
                raise Exception("'{}' ({}) apparaît dans deux registres : {} et {}".format(value, kind, seen[kind][value], info["register"]))
            seen[kind][value] = info["register"]

# Chaque bibliothèque exclut les dossiers des autres (en pratique : ses sous-dossiers qui en possèdent une).
for info in libraries_info:
    others = [other["dir"] for other in libraries_info if other is not info]
    info["sources"] = collect_sources(info["dir"], excluded=others)


# --- 2. Environnement godot-cpp ---
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])


# --- 2b. compile_commands.json (pour clangd / l'autocomplétion de l'éditeur) ---
# Le fichier n'est pas versionné (.gitignore) : il dépend de l'OS (compilateur, options, chemins absolus).
# Il est généré automatiquement, en plus de la compilation, quand il est absent du projet, ou quand il a été
# produit sur un autre OS / à un autre emplacement (son champ "directory" ne correspond pas à ce projet).
#   scons compiledb   -> le régénère à la demande (après l'ajout ou la suppression de fichiers .cpp)
# La génération elle-même est fournie par godot-cpp (alias "compiledb", outil SCons compilation_db) ;
# il contient toutes les sources connues de SCons, y compris celles de godot-cpp.
COMPILE_DB = os.path.join(Dir("#").abspath, env["compiledb_file"])


def compile_db_needs_generation(path):
    """Vrai si compile_commands.json est absent, illisible ou généré pour un autre OS / dossier."""
    import json

    if not os.path.isfile(path):
        return True
    try:
        with open(path, encoding="utf-8") as f:
            entries = json.load(f)
    except (OSError, ValueError):
        return True
    if not entries:
        return True
    # Sous Windows "D:\...", sous Linux "/home/..." : un fichier venu de l'autre OS ne correspond jamais.
    return os.path.normcase(os.path.normpath(entries[0].get("directory", ""))) != os.path.normcase(Dir("#").abspath)


if not env.get("compiledb", False) and compile_db_needs_generation(COMPILE_DB):
    print("{} absent ou généré pour un autre OS : il sera (re)généré pour {}.".format(
        os.path.basename(COMPILE_DB), env["platform"]))
    if COMMAND_LINE_TARGETS:
        BUILD_TARGETS.append("compiledb")  # ex. `scons journal` : on l'ajoute aux cibles demandées
    else:
        Default("compiledb")


# --- 3. Génération des fichiers .gdextension ---
# Même liste de plateformes que les .gdextension écrits à la main auparavant. {name} -> nom de la bibliothèque.
LIBRARY_PATTERNS = [
    ("macos.debug", "lib{name}.macos.template_debug.dylib"),
    ("macos.release", "lib{name}.macos.template_release.dylib"),
    ("windows.debug.x86_32", "{name}.windows.template_debug.x86_32.dll"),
    ("windows.release.x86_32", "{name}.windows.template_release.x86_32.dll"),
    ("windows.debug.x86_64", "{name}.windows.template_debug.x86_64.dll"),
    ("windows.release.x86_64", "{name}.windows.template_release.x86_64.dll"),
    ("linux.debug.x86_64", "lib{name}.linux.template_debug.x86_64.so"),
    ("linux.release.x86_64", "lib{name}.linux.template_release.x86_64.so"),
    ("linux.debug.arm64", "lib{name}.linux.template_debug.arm64.so"),
    ("linux.release.arm64", "lib{name}.linux.template_release.arm64.so"),
    ("linux.debug.rv64", "lib{name}.linux.template_debug.rv64.so"),
    ("linux.release.rv64", "lib{name}.linux.template_release.rv64.so"),
    ("android.debug.arm64", "lib{name}.android.debug.arm64.so"),
    ("android.release.arm64", "lib{name}.android.release.arm64.so"),
    ("android.debug.arm32", "lib{name}.android.debug.arm32.so"),
    ("android.release.arm32", "lib{name}.android.release.arm32.so"),
]


ICON_ENTRY = re.compile(r'^\s*(\w+)\s*=\s*"(.*)"\s*$')


def existing_icons(path):
    """Icônes déjà présentes dans la section [icons] d'un .gdextension (ajoutées à la main ou par @icon)."""
    icons = {}
    if not os.path.isfile(path):
        return icons
    in_icons = False
    with open(path, encoding="utf-8") as f:
        for line in f:
            stripped = line.strip()
            if stripped.startswith("["):
                in_icons = stripped == "[icons]"
            elif in_icons:
                match = ICON_ENTRY.match(stripped)
                if match:
                    icons[match.group(1)] = match.group(2)
    return icons


def gdextension_text(info, path):
    res_dir = "res://" + os.path.relpath(info["bin_dir"], PROJECT_DIR).replace("\\", "/")
    # Les icônes déjà écrites dans le fichier sont conservées ; un « // @icon » du registre ajoute
    # ou remplace l'icône de sa classe. Pour retirer une icône : la supprimer du fichier ET du registre.
    icons = existing_icons(path)
    icons.update({class_name: icon for class_name, icon in info["classes"].items() if icon})
    lines = [
        "; Généré par le Sconstruct depuis {} : seule la section [icons] peut être modifiée à la main.".format(info["register"].replace("\\", "/")),
        "",
        "[configuration]",
        "",
        'entry_symbol = "{}"'.format(info["entry_symbol"]),
        'compatibility_minimum = "4.7"',
        "reloadable = true",
        "",
        "[icons]",
        "",
    ]
    lines += ['{} = "{}"'.format(class_name, icon) for class_name, icon in icons.items()]
    lines += ["", "[libraries]", ""]
    lines += ['{} = "{}/{}"'.format(tag, res_dir, pattern.format(name=info["name"])) for tag, pattern in LIBRARY_PATTERNS]
    return "\n".join(lines) + "\n"


def write_if_changed(path, text):
    """N'écrit que si le contenu change : évite un rechargement inutile par Godot et un faux diff git."""
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            if f.read() == text:
                return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)
    print("Écrit :", path)


# Écriture immédiate (pendant la lecture du script, pas pendant la compilation) : tous les .gdextension
# sont donc à jour à chaque `scons`, même quand on ne compile qu'un module.
for info in libraries_info:
    write_if_changed(info["gdextension"], gdextension_text(info, info["gdextension"]))


# --- 4. Gestion de la documentation (intégration des XML existants dans chaque lib) ---
if not os.path.isdir(DOC_DIR):
    os.makedirs(DOC_DIR)
    print("{}/ créé (vide) : les XML seront générés après la compilation.".format(DOC_DIR))
xml_files = Glob(DOC_DIR + "/*.xml")
with_docs = env["target"] in ["editor", "template_debug"] and hasattr(env, "GodotCPPDocData")
if not xml_files:
    print("Avertissement: Aucun fichier .xml trouvé dans doc_classes/. La documentation ne sera pas incluse.")
elif not with_docs:
    print("Avertissement: documentation non incluse (cible '{}' ou godot-cpp < 4.3).".format(env["target"]))


# --- 5. Compilation des bibliothèques ---
# Avertissements activés pour le code des modules uniquement (environnement cloné : godot-cpp garde ses options).
module_env = env.Clone()
if module_env.get("is_msvc", False):
    module_env.Append(CCFLAGS=["/W4"])
else:
    module_env.Append(CCFLAGS=["-Wall", "-Wextra"])
    # En-têtes godot-cpp inclus comme en-têtes système (-isystem) : leurs propres avertissements
    # (des milliers de -Wunused-parameter) masqueraient ceux de notre code.
    godot_cpp_dir = Dir("#godot-cpp").abspath
    godot_cpp_includes = [p for p in module_env["CPPPATH"] if str(Dir(p).srcnode().abspath).startswith(godot_cpp_dir)]
    module_env["CPPPATH"] = [p for p in module_env["CPPPATH"] if p not in godot_cpp_includes]
    for p in godot_cpp_includes:
        module_env.Append(CCFLAGS=["-isystem", Dir(p).abspath])

libraries = []
for info in libraries_info:
    sources = list(info["sources"])
    # Seulement la doc des classes de cette bibliothèque (<NomDeClasse>.xml), sinon l'aide de l'éditeur
    # listerait des classes absentes quand le module n'est pas installé.
    library_xml = [x for x in xml_files if os.path.splitext(os.path.basename(str(x)))[0] in info["classes"]]
    if with_docs and library_xml:
        sources.append(env.GodotCPPDocData("src/gen/doc_data_{}.gen.cpp".format(info["name"]), source=library_xml))

    library = module_env.SharedLibrary(
        "{}/{}{}{}".format(info["bin_dir"], info["name"], env["suffix"], env["SHLIBSUFFIX"]),
        source=sources
    )
    env.Alias(info["alias"], library)  # permet : scons <id>  /  scons principal
    libraries.append(library)
    print("{} ({}) : {} fichier(s) .cpp, {} classe(s), {} doc(s)".format(
        info["alias"], info["register"], len(info["sources"]), len(info["classes"]), len(library_xml) if with_docs else 0))

Default(libraries)


# --- 6. Génération des XML de documentation via Godot --doctool ---
# Godot charge les bibliothèques compilées du projet et écrit un XML par classe d'extension.
# Les XML ne peuvent être produits qu'APRÈS la compilation : ceux créés pendant un build seront
# intégrés à la bibliothèque au `scons` suivant.
#
# ATTENTION : --doctool SUPPRIME les XML des classes qu'il ne trouve pas chargées (bibliothèque
# absente, pas encore compilée, ou dont la compilation a échoué) et reformate les autres.
# Il travaille donc dans un dossier temporaire, et seuls les fichiers voulus sont recopiés
# dans doc_classes/ : aucun XML n'y est jamais supprimé.


def missing_doc_classes(classes):
    """Parmi `classes`, celles qui n'ont pas encore de doc_classes/<Classe>.xml."""
    return [c for c in classes if not os.path.isfile(os.path.join(DOC_DIR, c + ".xml"))]


def declare_extensions_to_project():
    """Ajoute les .gdextension générés à .godot/extension_list.cfg.

    --doctool ne charge que les extensions listées dans ce fichier, que seul l'éditeur met à jour
    en parcourant le projet : sans cela, un module tout juste créé ne serait pas documenté.
    Les lignes existantes sont conservées.
    """
    path = os.path.join(PROJECT_DIR, ".godot", "extension_list.cfg")
    listed = []
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            listed = [line.strip() for line in f if line.strip()]
    wanted = ["res://" + os.path.relpath(info["gdextension"], PROJECT_DIR).replace("\\", "/") for info in libraries_info]
    missing = [w for w in wanted if w not in listed]
    if missing:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8", newline="\n") as f:
            f.write("\n".join(listed + missing) + "\n")


def run_doctool(only_new):
    """Lance Godot --doctool --gdextension-docs dans un dossier temporaire et recopie les XML.

    only_new=True  : ne recopie que les XML qui n'existent pas encore dans doc_classes/.
    only_new=False : recopie tous les XML produits (mise à jour complète, descriptions conservées).
    Renvoie (code de retour de Godot, liste des classes recopiées).
    """
    import shutil
    import tempfile

    if not os.path.isfile(GODOT_EXECUTABLE):
        print("Avertissement : Godot introuvable ({}).".format(GODOT_EXECUTABLE))
        print("  Indique son chemin avec  scons godot=<chemin>  ou la variable d'environnement GODOT.")
        return 1, []
    declare_extensions_to_project()

    work_dir = tempfile.mkdtemp(prefix="doctool_")
    try:
        # Copie des XML existants : Godot les fusionne, ce qui conserve les descriptions rédigées.
        shutil.copytree(DOC_DIR, os.path.join(work_dir, "doc_classes"))
        cmd = [
            GODOT_EXECUTABLE,
            "--headless",
            "--path", PROJECT_DIR,
            "--doctool", work_dir,  # Godot écrit dans <work_dir>/doc_classes/
            "--gdextension-docs",   # uniquement les classes des GDExtensions, pas l'API du moteur
        ]
        print("Exécution :", " ".join('"{}"'.format(c) if " " in c else c for c in cmd))
        returncode = subprocess.run(cmd).returncode
        if returncode != 0:
            print("Erreur : --doctool a retourné le code {}".format(returncode))

        copied = []
        produced_dir = os.path.join(work_dir, "doc_classes")
        for file in sorted(os.listdir(produced_dir)):
            destination = os.path.join(DOC_DIR, file)
            if not file.endswith(".xml") or (only_new and os.path.isfile(destination)):
                continue
            with open(os.path.join(produced_dir, file), "rb") as f:
                content = f.read()
            if os.path.isfile(destination):
                with open(destination, "rb") as f:
                    if f.read() == content:
                        continue
            with open(destination, "wb") as f:
                f.write(content)
            copied.append(os.path.splitext(file)[0])
        return returncode, copied
    finally:
        shutil.rmtree(work_dir, ignore_errors=True)


def generate_missing_docs_action(target, source, env):
    documented = [c for info in libraries_info for c in info["documented"]]
    missing = missing_doc_classes(documented)
    if not missing:
        return 0
    print("Documentation absente pour : {}".format(", ".join(missing)))
    run_doctool(only_new=True)
    created = [c for c in missing if c not in missing_doc_classes(missing)]
    still_missing = missing_doc_classes(missing)
    if created:
        print("XML créés : {}. Relance `scons` pour les intégrer à la bibliothèque.".format(", ".join(created)))
    if still_missing:
        print("Avertissement : toujours sans XML : {} (classe non chargée par Godot ?)".format(", ".join(still_missing)))
    return 0  # une doc manquante ne fait pas échouer le build


# Effet de bord commun aux deux commandes ci-dessous : SCons n'exécute jamais en parallèle (-j)
# deux commandes qui partagent un SideEffect.
DOCTOOL_LOCK = os.path.join(DOC_DIR, ".doctool")

# 6a. Automatique : après la compilation, s'il manque des XML.
# Seulement en template_debug : c'est la build que l'éditeur (donc --doctool) charge d'après les
# .gdextension ; en editor ou template_release, Godot chargerait d'anciennes bibliothèques debug.
# Dépend de TOUTES les bibliothèques : Godot les charge toutes, et ne doit pas en ouvrir une pendant
# que l'éditeur de liens l'écrit. Si l'une ne compile pas, la doc n'est donc pas générée.
missing_at_start = missing_doc_classes([c for info in libraries_info for c in info["documented"]])
if AUTO_DOC and env["target"] == "template_debug" and missing_at_start:
    auto_doc = env.Command(
        # Les XML manquants sont les cibles : SCons lance l'action tant qu'ils n'existent pas.
        target=[os.path.join(DOC_DIR, c + ".xml") for c in missing_at_start],
        source=libraries,
        action=generate_missing_docs_action,
    )
    env.SideEffect(DOCTOOL_LOCK, auto_doc)
    env.NoClean(auto_doc)  # `scons -c` ne doit jamais supprimer la doc
    Default(auto_doc)
    print("Documentation à générer après la compilation : {}".format(", ".join(missing_at_start)))


# 6b. Manuelle : met à jour TOUS les XML (nouvelles méthodes, propriétés...).  ->  scons gen_doc
def generate_doc_action(target, source, env):
    returncode, copied = run_doctool(only_new=False)
    print("XML mis à jour : {}".format(", ".join(copied) if copied else "aucun"))
    return returncode

gen_doc = env.Command(
    target="gen_doc_dummy",  # cible factice : jamais créée, donc l'action est relancée à chaque fois
    source=libraries,
    action=generate_doc_action
)
env.SideEffect(DOCTOOL_LOCK, gen_doc)

env.Alias("gen_doc", gen_doc)
