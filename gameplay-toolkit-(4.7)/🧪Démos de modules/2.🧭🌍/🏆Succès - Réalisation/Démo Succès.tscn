locked_icon = SubResource("Icone_verrouillee")
category = 2
conditions = Array[AchievementCondition]([SubResource("Cond_pieces")])

[sub_resource type="Achievement" id="Succes_joaillier"]
id = &"joaillier"
display_name = "Joaillier"
description = "Trouver chaque gemme : rubis, saphir, émeraude, topaze et améthyste."
icon = SubResource("Icone_objets")
locked_icon = SubResource("Icone_verrouillee")
category = 2
conditions = Array[AchievementCondition]([SubResource("Cond_gemmes")])

[sub_resource type="Achievement" id="Succes_explorateur"]
id = &"explorateur"
display_name = "Grand voyageur"
description = "Visiter la forêt, le désert, la toundra et la jungle."
icon = SubResource("Icone_exploration")
locked_icon = SubResource("Icone_verrouillee")
