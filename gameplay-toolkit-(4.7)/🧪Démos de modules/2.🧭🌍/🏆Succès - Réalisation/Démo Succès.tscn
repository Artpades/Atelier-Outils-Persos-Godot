[node name="Fond" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.09, 0.09, 0.11, 1)

[node name="Gestionnaire" type="AchievementManager" parent="."]
achievements = Array[Achievement]([SubResource("Succes_premier_sang"), SubResource("Succes_chasseur_slimes"), SubResource("Succes_tresorier"), SubResource("Succes_joaillier"), SubResource("Succes_explorateur"), SubResource("Succes_record"), SubResource("Succes_pile_ou_face"), SubResource("Succes_doigts_de_fee"), SubResource("Succes_chasseur_succes"), SubResource("Succes_aventurier")])
save_path = "user://demo_succes.cfg"
notification_position = 1

[node name="Marges" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_right = -440.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Zone" type="VBoxContainer" parent="Marges"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Panneau" type="PanelContainer" parent="."]
layout_mode = 0
script = ExtResource("2_panneau")
titre = "🏆 Succès - Réalisation"
aide = "Les boutons de gauche simulent le jeu : ils appellent seulement notify(évènement, id, quantité). Chaque condition décide si l'évènement la concerne. La progression est sauvegardée et retrouvée au prochain lancement."
