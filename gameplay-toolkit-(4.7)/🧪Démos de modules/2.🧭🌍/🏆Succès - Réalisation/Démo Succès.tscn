[sub_resource type="AchievementCounterCondition" id="Cond_cinq_succes"]
event_name = &"achievement_unlocked"
target = 5.0

[sub_resource type="AchievementCollectionCondition" id="Cond_aventurier"]
event_name = &"achievement_unlocked"
required_ids = PackedStringArray("joaillier", "explorateur", "record")

[sub_resource type="Achievement" id="Succes_premier_sang"]
id = &"premier_sang"
display_name = "Premier sang"
description = "Vaincre un ennemi, n'importe lequel."
icon = SubResource("Icone_combat")
locked_icon = SubResource("Icone_verrouillee")
category = 1
conditions = Array[AchievementCondition]([SubResource("Cond_premier_sang")])

[sub_resource type="Achievement" id="Succes_chasseur_slimes"]
id = &"chasseur_slimes"
display_name = "Fléau des slimes"
