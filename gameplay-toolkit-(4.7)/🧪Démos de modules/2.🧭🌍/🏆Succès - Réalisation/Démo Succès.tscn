[sub_resource type="AchievementCondition" id="Cond_premier_sang"]
event_name = &"enemy_killed"

[sub_resource type="AchievementCounterCondition" id="Cond_slimes"]
event_name = &"enemy_killed"
event_ids = PackedStringArray("slime")
target = 10.0

[sub_resource type="AchievementCounterCondition" id="Cond_pieces"]
event_name = &"coin_collected"
target = 100.0

[sub_resource type="AchievementCollectionCondition" id="Cond_gemmes"]
event_name = &"gem_found"
required_ids = PackedStringArray("rubis", "saphir", "émeraude", "topaze", "améthyste")

[sub_resource type="AchievementCollectionCondition" id="Cond_biomes"]
event_name = &"biome_visited"
required_ids = PackedStringArray("forêt", "désert", "toundra", "jungle")

[sub_resource type="AchievementCounterCondition" id="Cond_score"]
event_name = &"score"
target = 1000.0
value_mode = 1

[sub_resource type="AchievementCondition" id="Cond_boss_vaincu"]
condition_name = &"vaincu"
event_name = &"boss_defeated"

[sub_resource type="AchievementCounterCondition" id="Cond_boss_fui"]
