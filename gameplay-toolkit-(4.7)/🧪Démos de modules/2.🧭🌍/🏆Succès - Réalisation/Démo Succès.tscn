locked_icon = SubResource("Icone_verrouillee")
category = 1
conditions = Array[AchievementCondition]([SubResource("Cond_slimes")])

[sub_resource type="Achievement" id="Succes_tresorier"]
id = &"tresorier"
display_name = "Trésorier"
