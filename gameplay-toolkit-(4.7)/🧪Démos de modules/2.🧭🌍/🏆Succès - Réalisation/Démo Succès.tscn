icon = SubResource("Icone_meta")
locked_icon = SubResource("Icone_verrouillee")
category = 0
conditions = Array[AchievementCondition]([SubResource("Cond_aventurier")])

[node name="DémoSuccès" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
