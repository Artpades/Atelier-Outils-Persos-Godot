[sub_resource type="Achievement" id="Succes_record"]
id = &"record"
display_name = "Champion"
description = "Atteindre un score de 1 000 en une seule partie."
icon = SubResource("Icone_defi")
locked_icon = SubResource("Icone_verrouillee")
category = 4
conditions = Array[AchievementCondition]([SubResource("Cond_score")])

[sub_resource type="Achievement" id="Succes_pile_ou_face"]
id = &"pile_ou_face"
display_name = "Pile ou face"
description = "Vaincre le boss… ou le fuir 3 fois."
icon = SubResource("Icone_defi")
locked_icon = SubResource("Icone_verrouillee")
category = 4
conditions = Array[AchievementCondition]([SubResource("Cond_boss_vaincu"), SubResource("Cond_boss_fui")])
completion_mode = 1

[sub_resource type="Achievement" id="Succes_doigts_de_fee"]
id = &"doigts_de_fee"
display_name = "Doigts de fée"
description = "Cliquer 5 fois en moins d'une seconde et demie (condition écrite en GDScript)."
icon = SubResource("Icone_defi")
locked_icon = SubResource("Icone_verrouillee")
category = 4
hidden = true
conditions = Array[AchievementCondition]([SubResource("Cond_clics")])

[sub_resource type="Achievement" id="Succes_chasseur_succes"]
id = &"chasseur_succes"
display_name = "Chasseur de succès"
