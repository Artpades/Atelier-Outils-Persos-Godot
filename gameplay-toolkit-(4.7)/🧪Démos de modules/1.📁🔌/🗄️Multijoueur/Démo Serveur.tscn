[gd_scene format=3]

[ext_resource type="Script" path="res://🧪Démos de modules/1.📁🔌/🗄️Multijoueur/demo_serveur.gd" id="1_serveur"]

[node name="DémoServeur" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
