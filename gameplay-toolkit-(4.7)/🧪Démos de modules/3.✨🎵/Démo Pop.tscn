[node name="Panneau" type="PanelContainer" parent="Interface"]
script = ExtResource("2_panneau")
titre = "💥 Pop de texte, d'images et d'objets"
aide = "Chaque PopSpawner a son PopStyle (sélectionne-les pour voir les réglages) : dégâts qui retombent, pièces qui rebondissent sur le sol en tournant, étoiles projetées dans toutes les directions. « PAF ! » est un FXPop enchaîné à la secousse du mannequin. Le bouton « Acheter » fait pop dans l'interface (CanvasLayer)."
