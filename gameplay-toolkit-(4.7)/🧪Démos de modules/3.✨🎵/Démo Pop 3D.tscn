[node name="Panneau" type="PanelContainer" parent="Interface"]
script = ExtResource("2_panneau")
titre = "💥 Pops en 3D"
aide = "En 3D, les pops font face à la caméra ; les distances du PopStyle sont en pixels, converties par unit_scale_3d (0,01 : 100 px = 1 m), si bien que les styles 2D restent utilisables. « À l'écran » (screen_space_3d) affiche un pop 2D à la position projetée de la cible : texte net, taille constante. La cible se déplace : les pops restent là où ils sont apparus."
