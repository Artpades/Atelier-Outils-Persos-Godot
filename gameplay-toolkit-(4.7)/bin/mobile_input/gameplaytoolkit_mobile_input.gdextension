; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/1.📁Intercepteurs de données🔌/📱Gestion d'entrée de touché d'écran/mobile_input_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "mobile_input_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

MobileInput = "res://🖼️Editor Icons/🎮🔌/InputScreenSphere Icon.png"

[libraries]

macos.debug = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.macos.template_debug.dylib"
macos.release = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.macos.template_release.dylib"
windows.debug.x86_32 = "res://bin/mobile_input/gameplaytoolkit_mobile_input.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/mobile_input/gameplaytoolkit_mobile_input.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/mobile_input/gameplaytoolkit_mobile_input.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/mobile_input/gameplaytoolkit_mobile_input.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.linux.template_release.rv64.so"
android.debug.arm64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.android.debug.arm64.so"
android.release.arm64 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.android.release.arm64.so"
android.debug.arm32 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.android.debug.arm32.so"
android.release.arm32 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.android.release.arm32.so"
web.debug.threads.wasm32 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "res://bin/mobile_input/libgameplaytoolkit_mobile_input.web.template_release.wasm32.wasm"
