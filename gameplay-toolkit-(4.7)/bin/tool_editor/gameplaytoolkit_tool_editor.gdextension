; Généré par le Sconstruct depuis src/1.🧰Ensemble d'Outils/0.🧑‍💻Édition et Debug🪳/tool_editor_register.cpp : seule la section [icons] peut être modifiée à la main.

[configuration]

entry_symbol = "tool_editor_library_init"
compatibility_minimum = "4.7"
reloadable = true

[icons]

ManagerBuilder = "res://🖼️Editor Icons/🧰🧑‍💻/ManagerBase icon.png"
WindowEditor = "res://🖼️Editor Icons/🧰🧑‍💻/WindowEditor icon.png"
Gizmos2D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
Gizmos3D = "res://🖼️Editor Icons/🧰🧑‍💻/Pix. Gizmos Icon.png"
ProceduralEditor = "res://🖼️Editor Icons/🧰🧑‍💻/Settings Panel Icon.png"
PropertyWidget = "res://🖼️Editor Icons/🧰🧑‍💻/CustomEditorProperty icon.png"

